{
	"name": "@osrim/ski",
	"version": "0.2.1",
	"private": true,
	"description": "Skill manager for coding agents",
	"type": "module",
	"bin": {
		"ski": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "bun build --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/index.ts --outfile dist/ski",
		"lint": "oxlint src scripts",
		"lint:fix": "oxlint --fix src scripts",
		"fmt": "oxfmt src scripts",
		"fmt:check": "oxfmt --check src scripts",
		"test": "bun test --timeout 30000"
	},
	"dependencies": {
		"@clack/prompts": "1.7.0",
		"ansis": "4.3.1",
		"cac": "7.0.0",
		"cli-truncate": "6.1.1",
		"empathic": "2.0.1",
		"fast-wrap-ansi": "0.2.2",
		"linkify-it": "6.1.0",
		"markdown-it": "15.0.1",
		"pretty-bytes": "7.1.3",
		"supports-color": "11.0.0",
		"write-file-atomic": "8.0.0",
		"yaml": "2.9.0",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@types/bun": "1.4.1",
		"@types/write-file-atomic": "4.0.3",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"typescript": "6.0.3"
	}
}
